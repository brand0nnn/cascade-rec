# Python environments and generated files
.venv/
__pycache__/
.pytest_cache/
*.py[cod]
*.egg-info/

# Local editor and operating-system files
.idea/
.DS_Store

# Local datasets and experiment logs
/data/
/log/
/log_tensorboard/

# Generated model and evaluation outputs
/results/**/*.npy
/results/**/*.pth
/results/**/recbole.log

# Trained retriever weights (full-data runs only are small enough to share)
!/results/retriever/*/seed*/model.pth
/results/retriever/*_sample/seed*/model.pth

# Logs stay local; keep the directory for Slurm job output.
/results/logs/*
!/results/logs/.gitkeep

# Ranker output is local by default. Explicitly shared artifacts are tracked via
# results/ranker_artifacts.json (use git add -f only for that reviewed allowlist).
/results/ranker_*/

# Consolidated evaluation handoff: share compact evidence, keep generated copies local.
/docs/_local_evaluation_archive/
/results/targeted_study/
/results/saved_evaluation/*
!/results/saved_evaluation/20261027-saved-validation/
/results/saved_evaluation/20261027-saved-validation/*
!/results/saved_evaluation/20261027-saved-validation/provenance.json
!/results/saved_evaluation/20261027-final-validation/
/results/saved_evaluation/20261027-final-validation/*
!/results/saved_evaluation/20261027-final-validation/*.csv
!/results/saved_evaluation/20261027-final-validation/*.json
!/results/saved_evaluation/20261027-final-validation/config.yaml
!/results/saved_evaluation/20261027-final-validation/git_hash.txt
/results/explanation_graph/*
!/results/explanation_graph/20261027-base/
/results/explanation_graph/20261027-base/*
!/results/explanation_graph/20261027-base/manifest.json
!/results/explanation_graph/20261027-base/device_audit_development.csv
!/results/explanation_graph/20261027-base/device_audit_locked.csv
!/results/explanation_graph/20261027-target-profiles-verified/
/results/explanation_graph/20261027-target-profiles-verified/*
!/results/explanation_graph/20261027-target-profiles-verified/*.csv
!/results/explanation_graph/20261027-target-profiles-verified/provenance.json
!/results/explanation_graph/20261027-target-profiles-verified/examples.json
/results/evaluation_completion/*
!/results/evaluation_completion/20261028-final/
/results/evaluation_completion/20261028-final/*
!/results/evaluation_completion/20261028-final/*.csv
!/results/evaluation_completion/20261028-final/*.json

# Share compact evidence for the expanded target evaluation; per-event rows stay local.
!/results/evaluation_completion/20261101-kg-expanded-final/
/results/evaluation_completion/20261101-kg-expanded-final/*
!/results/evaluation_completion/20261101-kg-expanded-final/*.csv
!/results/evaluation_completion/20261101-kg-expanded-final/*.json
!/results/evaluation_completion/20261101-kg-expanded-final/report.md

# Fresh local baseline fits, exports and token mappings stay local.
/results/baselines/local/

# Independent local experiments: vectors, caches, checkpoints and generated reports.
/results/local_experiments/

# Candidate-list copies in analysis runs are too large for GitHub (keep local)
/results/analysis/**/val.npz

# Hybrid study per-event rank archives (large; kept local/cluster)
/results/hybrid_study/**/*.npz
/results/hybrid_study/localdev-*/
