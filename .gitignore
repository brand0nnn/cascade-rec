.venv/
/data/
__pycache__/
*.pyc
/saved/
/log/
/log_tensorboard/
results/**/*.npy
results/**/*.pth
.DS_Store
*.egg-info/
# trained retriever weights (full-data runs only) are small enough to share through git (2026-10-21)
!results/retriever/*/seed*/model.pth
results/retriever/*_sample/seed*/model.pth
# logs stay local (the folder itself is kept: Slurm writes job output there and fails if it is missing)
results/logs/*
!results/logs/.gitkeep
results/**/recbole.log
# Ranker output is local by default. Explicitly shared artifacts are tracked via
# results/ranker_artifacts.json (use git add -f only for that reviewed allowlist).
results/ranker_*/
